MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_change_me

# Öffentliche URL unter der 3D Tiles erreichbar sind (für CesiumJS tileset.json).
# Lokal: über den API-Proxy, dort ist CORS bereits offen.
TILES_PUBLIC_URL=http://localhost:8100/tiles

# Referenzpunkt (WGS84), an dem lokal koordinierte Modelle verortet werden.
# Ohne diese Angabe läge ein IFC/OBJ mit Koordinaten um (0,0,0) im Erdmittelpunkt.
TILESET_ORIGIN_LON=8.2599
TILESET_ORIGIN_LAT=49.9929

# Bezug der Höhe: terrain = über Geländeoberkante (DEM-Abfrage), msl = über NHN,
# ellipsoid = roh über dem WGS84-Ellipsoid. CesiumJS zeigt Modelle auf Terrain —
# mit "terrain" und 0 sitzt ein Neuupload direkt auf dem Gelände.
TILESET_ORIGIN_HEIGHT_REFERENCE=terrain
TILESET_ORIGIN_HEIGHT=0

# Geoidundulation am Standort (EGM2008): Abstand NHN-Niveau ↔ Ellipsoid.
# 47.6 gilt für Rhein-Main; in Deutschland variiert sie nur um ~1 m je 50 km,
# eine Konstante ist deshalb genauer als der IFC-Nullpunkt selbst.
# Nachschlagen z.B. über den Geoidrechner des BKG.
GEOID_UNDULATION_M=47.6

# DEM-Dienst für die Geländehöhe (Copernicus DEM 90 m, ohne Schlüssel).
# Leer = abgeschaltet; dann wirkt "terrain" wie "msl" und die Höhe ist ohne
# Geländebezug — der einzige Punkt im Stack, der ins Internet greift.
ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation

# CRS der Punktwolken-Quelldaten, z.B. EPSG:25832 für UTM32N. Nur nötig, wenn
# der LAS-Header keins enthält — sonst wird es von dort gelesen. Ohne beides
# landet die Wolke am Referenzpunkt oben.
POINTCLOUD_CRS_IN=

# ── Lokale Geländereferenz ───────────────────────────────────────────────────
# Wer im Asset-Manager ein Modell als Geländereferenz markiert (Button unter
# "Position & Ausrichtung"), bekommt daraus ein Höhenraster — genauer als das
# globale Copernicus-DEM und exakt das, was vor Ort tatsächlich vermessen bzw.
# modelliert wurde. Siehe tiling/terrain.py.
# Zellgröße des Höhenrasters in Metern.
TERRAIN_GRID_RESOLUTION_M=2.0
# Obergrenze eingelesener Punkte — darüber wird zufällig ausgedünnt.
TERRAIN_GRID_MAX_POINTS=4000000

# ── Gaussian Splats (3DGS-PLY) ───────────────────────────────────────────────
# Obergrenze für die Gesamtszene. Das Tileset ist ein Octree, geladen werden nur
# sichtbare Tiles — alle geladenen Splats liegen aber gemeinsam im GPU-Speicher.
SPLAT_MAX_POINTS=6000000
# Splats je Tile des alten ADD-Octrees (SPLAT_LOD=add).
SPLAT_TILE_POINTS=250000
# LOD-Aufbau: "hlod" = Eltern aus zusammengeführten Splats, refine REPLACE
# (Standard seit #8); "add" = Zufallsauswahl je Knoten, refine ADD (vorher).
# Messungen: frontend/tests/splat-bench/ergebnisse/VERGLEICH.md
SPLAT_LOD=hlod
# Splats je Blatt beim HLOD-Octree. 50k–200k gemessen: kleiner = weniger und
# kürzere Ruckler beim Nachladen, dafür mehr Tiles und Ebenen.
SPLAT_HLOD_TILE_POINTS=100000
# Reduktion je Ebene: ein Elternknoten trägt ~1/Faktor der Splats seiner Kinder.
SPLAT_MERGE_FAKTOR=4
# Hüllkasten je Tile inklusive k·σ der größten Splat-Halbachse (0 = nur Mitten).
SPLAT_BOX_SIGMA=3
# Splats je Tile in Z-Ordnung (−5…8 % Tilegröße durch besseres gzip).
SPLAT_MORTON=1
# tileset.json ohne Einrückung (−70 %).
SPLAT_JSON_KOMPAKT=1
# Höhere SH-Ordnungen mitschreiben (0–3). Grad 3 kostet +78 % Größe und die
# 2,5-fache Ladezeit; CesiumJS kann nur einen Grad je Tileset.
SPLAT_SH_GRAD=0
# Auslichten vor dem Tiling, je 0 = aus: Deckkraft unter, größte Halbachse
# unter (m), Schwebeteilchen über dem Vielfachen des medianen Abstands zum
# 16. Nachbarn. Letzteres nimmt auch dünne Vegetation mit — vorsichtig.
SPLAT_MIN_OPACITY=0
SPLAT_MIN_SCALE=0
SPLAT_FLOATER=0
# Größte zugelassene Splat-Halbachse als Anteil der Szenenausdehnung (gemessen
# am 1–99-Perzentil-Kasten, nicht an der Bounding Box — sonst heben die
# Ausreißer die Grenze mit an, an der sie gemessen werden). Filtert die wenigen
# riesigen Gaußverteilungen heraus, die 3DGS-Trainings hinterlassen und die als
# helle Schlieren durchs Bild ziehen. 0 schaltet den Filter ab.
SPLAT_MAX_SCALE_RATIO=0.05
# Zweite Grenze, unabhängig von der Szenengeometrie: Vielfaches der Median-
# Halbachse. Verworfen wird bei Überschreitung der kleineren beiden Grenzen.
SPLAT_MAX_SCALE_MEDIANS=8

# ── IFC-Tiling ───────────────────────────────────────────────────────────────
# Dreiecke je Tile. Bestimmt, wie fein das Modell zerlegt wird: 150k sind rund
# 5–8 MB je B3DM.
IFC_TILE_TRIANGLES=150000
# Maximale Octree-Tiefe. Bei jeder Ebene halbiert sich die Kantenlänge.
IFC_MAX_DEPTH=8
# Threads für die Geometrieerzeugung. Jeder kostet Speicher — bei einem
# 500-MB-Modell liegt die Spitze mit vier Threads bereits bei mehreren GB.
# 0 = automatisch (min(4, CPU-Kerne)).
IFC_JOBS=0
# Vertices verschweißen: spart etwa zwei Drittel der Daten, erzeugt aber
# gemittelte Normalen und dadurch weich schattierte Kanten. false liefert
# scharfe Flächennormalen bei etwa dreifacher Datenmenge.
IFC_WELD_VERTICES=true
# Property-Sets je Bauteil in properties.sqlite schreiben. Ohne sie bleiben
# angeklickte Bauteile auf GlobalId, Typ, Name und Geschoss beschränkt.
IFC_EXTRACT_PSETS=true
# Typen, die nicht getilet werden. IfcOpeningElement sind Aussparungsvolumen —
# die Wand hat ihr Loch schon, der Negativkörper steckt sonst als massiver
# Quader darin und ragt als Platte durch die Fassade.
IFC_EXCLUDE_TYPES=IfcOpeningElement,IfcSpace,IfcVirtualElement,IfcAnnotation,IfcGrid


# ── Flugverkehr (OpenSky Network) ────────────────────────────────────────────
# Der Viewer fragt nie direkt bei OpenSky an, sondern über /flug/zustaende:
# das client_secret bliebe im Browser-Bundle nicht geheim, und ein Cache im
# Backend macht aus zehn offenen Tabs eine Abfrage.
#
# Zugangsdaten sind optional. Ohne sie läuft alles anonym weiter — dieselben
# Zustandsvektoren, aber 400 statt 4 000 Credits am Tag und 10-s-Auflösung.
# Anlegen: Konto auf opensky-network.org → Account → API Client erzeugen.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Abfragetakt in Sekunden, den das Backend dem Viewer vorgibt. Leer =
# modusabhängige Vorgabe (20 s mit Zugangsdaten, 60 s anonym). Eine Box bis
# 25 Quadratgrad kostet einen Credit je Abfrage — 20 s sind rund 4 300 am Tag.
OPENSKY_POLL_S=
# Vorhaltezeit einer Antwort im Backend. Leer = eine Sekunde unter dem Takt.
OPENSKY_CACHE_TTL_S=

# ── Splat-Training und Scan → Splat ──────────────────────────────────────────
# Obergrenze der Surfels, wenn ein Laserscan beim Hochladen als Gaussian Splat
# umgerechnet wird. Die Voxelgröße wächst automatisch, bis nicht mehr übrig sind.
SCAN_SPLAT_MAX=6000000
# Der Worker für das Foto-Training läuft nicht im Container, sondern auf dem Mac
# (COLMAP + Brush brauchen die Metal-GPU). Pfade nur setzen, wenn die Werkzeuge
# nicht am Standardort liegen:
#   BRUSH_BIN=~/Projekte/brush-app-aarch64-apple-darwin/brush_app
#   COLMAP_BIN=/opt/homebrew/bin/colmap
